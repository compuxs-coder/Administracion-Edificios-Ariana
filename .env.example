APP_NAME="Administracion de Edificios Ariana"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=administracion_edificios
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=administracion_edificios

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

COMUNICACION_DOCUMENT_DISK=communications
COMUNICACION_DOCUMENT_LEGACY_DISK=
COMUNICACION_DOCUMENT_LINK_MINUTES=43200

GOBIERNO_AUDITORIA_PAGE_SIZE=25
# JSON por fuente y tipo, por ejemplo: {"accesos.membresia_creada":3650,"comunicacion.*":1825}
GOBIERNO_RETENCION_EVENTOS='{}'
GOBIERNO_EXPORT_DISK=audit-exports
GOBIERNO_EXPORT_QUEUE_CONNECTION=database-exports
GOBIERNO_EXPORT_QUEUE=gobierno-exportaciones
GOBIERNO_EXPORT_QUEUE_RETRY_AFTER=900
GOBIERNO_EXPORT_TTL_HOURS=24
GOBIERNO_EXPORT_MAX_RANGE_DAYS=90
GOBIERNO_EXPORT_CHUNK_SIZE=1000
GOBIERNO_EXPORT_CSV_MAX_ROWS=50000
GOBIERNO_EXPORT_PDF_MAX_ROWS=2000
GOBIERNO_EXPORT_MAX_ACTIVE_PER_USER=2
GOBIERNO_EXPORT_MAX_DAILY_PER_USER=10
GOBIERNO_EXPORT_LEASE_SECONDS=900
GOBIERNO_EXPORT_ORPHAN_GRACE_SECONDS=1800
GOBIERNO_EXPORT_TEMP_MAX_AGE_SECONDS=3600
GOBIERNO_EXPORT_RECENT_SCAN_LIMIT=500
GOBIERNO_EXPORT_MAX_ATTEMPTS=3

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
